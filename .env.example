# AIHub 环境变量示例
# 复制为 .env 后按实际修改：cp .env.example .env

# 必填：PostgreSQL 连接串。
# 注意 SQLAlchemy 2.1 起 postgresql:// 的默认驱动是 psycopg(3)，
# 本项目依赖 psycopg2，database/conn.py 会自动改写成 postgresql+psycopg2://
DATABASE_URL=postgresql://user:password@host:5432/aihub?sslmode=disable

# 注册验证码邮件（163 邮箱 SMTP，实现见 Mail.py）。
# SMTP_PASSWORD 要填 163 邮箱的「授权码」（邮箱设置 → POP3/SMTP/IMAP 里开启服务时生成），
# 不是网页登录密码；不配置的话 /api/sign/up/1 会返回 500「邮件服务未配置」。
# 其余字段都可省略，省略时用注释里的默认值。
SMTP_HOST=smtp.163.com
SMTP_PORT=465
# ssl（465，默认）/ starttls（587）/ none（明文，仅内网中继）
SMTP_TLS=ssl
SMTP_TIMEOUT=20
SMTP_USER=ourpet001@163.com
SMTP_PASSWORD=
# 发件人显示名
SMTP_FROM_NAME=AIHub
