# AIHub 环境变量示例
# 复制为 .env 后按实际修改：cp .env.example .env

# 必填：PostgreSQL 连接串。
# 注意 SQLAlchemy 2.1 起 postgresql:// 的默认驱动是 psycopg(3)，
# 本项目依赖 psycopg2，database/conn.py 会自动改写成 postgresql+psycopg2://
DATABASE_URL=postgresql://user:password@host:5432/aihub?sslmode=disable

# 可选：development 时注册验证码固定为 888888（邮件发送尚未实现，
# 目前必须设成 development 才能完成注册）；不设置则视为生产环境，验证码随机。
ENVIRONMENT=development
